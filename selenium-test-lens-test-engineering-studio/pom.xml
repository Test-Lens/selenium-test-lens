<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.test-lens</groupId>
        <artifactId>selenium-test-lens-parent</artifactId>
        <version>0.5.0</version>
    </parent>
    <artifactId>selenium-test-lens-test-engineering-studio</artifactId>
    <name>Test Lens for Selenium — Test Engineering Studio</name>
    <description>Internal local Test Engineering Studio facade, projections, workspace, and secure transport.</description>
    <dependencies>
        <dependency><groupId>io.github.test-lens</groupId><artifactId>selenium-test-lens-application-mapper</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.github.test-lens</groupId><artifactId>selenium-test-lens-application-tooling</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.github.test-lens</groupId><artifactId>selenium-test-lens-selector-tooling</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId></dependency>
        <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-launcher</artifactId><version>1.10.2</version></dependency>
    </dependencies>
    <build><plugins><plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version><configuration><mainClass>io.github.testlens.studio.launcher.Main</mainClass></configuration></plugin></plugins></build>
</project>
